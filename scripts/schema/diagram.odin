#+private file
package schema

// -------------------------------- Imports --------------------------------

// ---------------- Odin ----------------

import "core:fmt"
import "core:reflect"
import "core:strings"

// -------------------------------- Constants --------------------------------

// ---------------- File ----------------

// These are diagram connectors, never fields in the game's state or save files.
CONNECTOR :: "__diagram_id"

// -------------------------------- Types --------------------------------

// ---------------- File ----------------

Diagram :: struct {
	text: strings.Builder,
	seen: map[typeid]bool,
}

// -------------------------------- Procedures --------------------------------

// ---------------- Package ----------------

@(private = "package")
generate :: proc(roots: []typeid, description: string) -> string {
	d := Diagram{seen = make(map[typeid]bool)}
	defer delete(d.seen)
	fmt.sbprintf(&d.text, "// Generated by scripts/build-dbml.sh from compiled Odin types. Do not edit.\n")
	fmt.sbprintf(&d.text, "Project devils_arena {{\n  Note: '''\n%s\n", description)
	fmt.sbprintf(&d.text, "Boxes are Odin types; lines show inline containment.\n")
	fmt.sbprintf(&d.text, "__diagram_id is a synthetic connector and is never stored.\n")
	fmt.sbprintf(&d.text, "Array positions are the real row keys. Array dimensions are shown in field types.\n")
	fmt.sbprintf(&d.text, "Types shared by multiple wrappers are drawn once; wrappers describe alternative payloads.\n  '''\n}}\n\n")
	for root in roots {emit_type(&d, type_info_of(root))}
	return strings.to_string(d.text)
}

// ---------------- File ----------------

emit_type :: proc(d: ^Diagram, info: ^reflect.Type_Info) {
	if d.seen[info.id] {return}
	name := type_name(info)
	for other in d.seen {
		assert(name != type_name(type_info_of(other)), "Diagram type names must be unique")
	}
	d.seen[info.id] = true
	base := reflect.type_info_base(info)
	#partial switch value in base.variant {
	case reflect.Type_Info_Struct:
		assert(value.soa_kind == .None && .raw_union not_in value.flags,
			   "Diagram generation needs explicit support for SoA and union structs")
		fmt.sbprintf(&d.text, "Table %s {{\n", name)
		fmt.sbprintf(&d.text, "  %s integer [pk, note: 'Diagram connector only; not stored']\n", CONNECTOR)
		for field in reflect.struct_fields_zipped(info.id) {
			assert(field.name != CONNECTOR, "State field conflicts with diagram connector")
			fmt.sbprintf(&d.text, "  %s \"%s\" [not null]\n", field.name, type_name(field.type))
		}
		fmt.sbprintf(&d.text, "  Note: 'Odin struct %s; nested values are stored inline.'\n}}\n\n", name)
		for field in reflect.struct_fields_zipped(info.id) {
			child := field.type
			many := false
			for {
				array, ok := reflect.type_info_base(child).variant.(reflect.Type_Info_Array)
				if !ok {break}
				child = array.elem
				many = true
			}
			child_base := reflect.type_info_base(child)
			#partial switch _ in child_base.variant {
			case reflect.Type_Info_Struct:
				emit_type(d, child)
				relation := "-"
				if many {relation = "<"}
				fmt.sbprintf(&d.text, "// Inline containment, not a stored foreign key.\nRef: %s.%s %s %s.%s\n\n",
							 name, field.name, relation, type_name(child), CONNECTOR)
			case reflect.Type_Info_Enum:
				emit_type(d, child)
			case reflect.Type_Info_Integer, reflect.Type_Info_Float,
				 reflect.Type_Info_Boolean, reflect.Type_Info_String:
				// Leaf values retain their Odin type, including array dimensions.
			case:
				panic(fmt.tprintf("Unsupported stored field: %s.%s (%v)", name, field.name, field.type.id))
			}
		}
	case reflect.Type_Info_Enum:
		fmt.sbprintf(&d.text, "Enum %s {{\n", name)
		for enum_name, i in value.names {
			fmt.sbprintf(&d.text, "  %s [note: 'Odin value %d']\n", enum_name, value.values[i])
		}
		fmt.sbprintf(&d.text, "}}\n\n")
	case:
		panic(fmt.tprintf("Expected a struct or enum root, got %v", info.id))
	}
}

type_name :: proc(info: ^reflect.Type_Info) -> string {
	if named, ok := info.variant.(reflect.Type_Info_Named); ok {return named.name}
	return fmt.tprintf("%v", info.id)
}
