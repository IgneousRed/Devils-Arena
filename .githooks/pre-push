#!/bin/sh
set -eu
case "${2:-}" in
    https://github.com/IgneousRed/Devils-Arena.git|git@github.com:IgneousRed/Devils-Arena.git) ;;
    *) echo 'Public push destination is not approved.' >&2; exit 1 ;;
esac
cd "$(git rev-parse --show-toplevel)"
exec ./scripts/dev python3 scripts/check-publication.py --push
